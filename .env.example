# ==============================================================================
# ASAKA ZIYO — Muhit O'zgaruvchilari Shablon (Environment Variables)
# ==============================================================================
# DIQQAT: Barcha o'zgaruvchilar 100% IXTIYORIYDIR.
# Ushbu kalitlar kiritilmagan taqdirda ham, ilova to'liq avtonom, xavfsiz va
# barcha admin o'zgarishlarini markaziy /data/asaka_ziyo_db.json bazasida
# doimiy saqlab ishlayveradi. Hech qanday majburiy Secret Value talab qilinmaydi!
# ==============================================================================

# Server & App Config
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Enterprise Security & Admin Authentication
# Agar ADMIN_SESSION_SECRET ko'rsatilmasa, server yuklanishda kriptografik 256-bitli kalit avtomatik yaratadi.
ADMIN_SESSION_SECRET=
# Bosh ma'mur (menageradmin) boshlang'ich login va paroli
ADMIN_INITIAL_USERNAME=menageradmin
ADMIN_INITIAL_PASSWORD=menageradmin1

# Google Gemini AI Islamic Assistant (Server-side only — never expose to browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Telegram Bot Integratsiyasi (Ixtiyoriy — Telegram kanallariga xabar yuborish uchun)
# Kanallar: @Asaka_Ziyo va @muhiddinsahhofuz
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@Asaka_Ziyo

# Supabase (Ixtiyoriy ikkilamchi bulutli zaxira nusxa)
# DIQQAT: SUPABASE_SERVICE_ROLE_KEY faqat serverda ishlatiladi, brauzerga hech qachon chiqmaydi!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Namoz API (Ixtiyoriy tashqi API)
# Kiritilmasa, Asaka shahri koordinatalari va O'MI standartlari asosidagi 8 namoz vaqti hisoblanadi.
VITE_PRAYER_API_ENDPOINT=
