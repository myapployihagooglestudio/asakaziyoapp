# ==============================================================================
# ASAKA ZIYO — Muhit O'zgaruvchilari Shablon (Environment Variables)
# ==============================================================================
# DIQQAT: Barcha o'zgaruvchilar 100% IXTIYORIYDIR.
# Ushbu kalitlar kiritilmagan taqdirda ham, ilova to'liq avtonom, xavfsiz va
# barcha admin o'zgarishlarini markaziy /data/asaka_ziyo_db.json bazasida
# doimiy saqlab ishlayveradi. Hech qanday majburiy Secret Value talab qilinmaydi!
# ==============================================================================

# Server & App Config
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Native Android APK uchun HTTPS backend manzili (ixtiyoriy — Play Market release buildda backend API URL)
VITE_API_BASE_URL=

# Enterprise Security & Admin Authentication
# Agar ADMIN_SESSION_SECRET ko'rsatilmasa, server yuklanishda kriptografik 256-bitli kalit avtomatik yaratadi.
ADMIN_SESSION_SECRET=
# Bosh ma'mur (menageradmin) boshlang'ich login va paroli
ADMIN_INITIAL_USERNAME=menageradmin
ADMIN_INITIAL_PASSWORD=menageradmin1

# Google Cloud Firebase Admin SDK (Ixtiyoriy — Server-side privileged Firestore operations)
# DIQQAT: Hech qachon VITE_ prefiksi bilan yoki frontend kodida ishlatmang!
# Kiritilmasa, server avtomatik ravishda Cryptographic Server-Gate Atomic Batch mexanizmi orqali
# ai-studio-asakaziyoapp-1ea697da-bde1-4c61-a495-c8b1e8c8ca94 bazasiga tasdiqlangan yozuvlarni amalga oshiradi.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Google Gemini AI Islamic Assistant (Server-side only — never expose to browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Mavjud Web App kanal integratsiyasi (eski modul — o'zgartirilmaydi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@Asaka_Ziyo

# ASAKA ZIYO Telegram Bot Platform (Alohida izolyatsiya qilingan yangi bot moduli)
# DIQQAT: Hech qachon VITE_ prefiksi bilan yoki frontend kodida ishlatmang!
# Yangi bot FAQAT TELEGRAM_BOT_TOKEN1 ga ulanadi.
TELEGRAM_BOT_TOKEN1=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_OWNER_ID=
TELEGRAM_ADMIN_IDS=
# webhook | polling | disabled (bo'sh qoldirilsa: webhook URL+secret bor bo'lsa webhook, aks holda polling)
TELEGRAM_MODE=

# Supabase (Ixtiyoriy ikkilamchi bulutli zaxira nusxa)
# DIQQAT: SUPABASE_SERVICE_ROLE_KEY faqat serverda ishlatiladi, brauzerga hech qachon chiqmaydi!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Namoz API (Ixtiyoriy tashqi API)
# Kiritilmasa, Asaka shahri koordinatalari va O'MI standartlari asosidagi 8 namoz vaqti hisoblanadi.
VITE_PRAYER_API_ENDPOINT=
