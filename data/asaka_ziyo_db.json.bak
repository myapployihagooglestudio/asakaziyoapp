                "questionUz": "Ramazon oyida uzrsiz roʻzani qasddan buzgan kishining kafforati qanday belgilanadi?",
                "sourceVerified": true,
                "publishedDate": "2026-11-02",
                "source": "Sahihi Buxoriy; Mukhtasarul Viqoya",
                "id": "q-013",
                "isApproved": true,
                "optionsUz": [
