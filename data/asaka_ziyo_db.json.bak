                ],
                "explanationUz": "Vodiy va butun Movarounnahrda Burhoniddin Margʻinoniy hazratlarining «Al-Hidoya» asari islom huquqi (fiqh) boʻyicha eng ishonchli va bosh qomus sifatida oʻrganilgan.",
                "isApproved": true,
                "status": "approved"
              },
