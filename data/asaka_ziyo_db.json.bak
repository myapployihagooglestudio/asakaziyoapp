            "adminEmail": "asakaziyo0@gmail.com",
            "collectionNameUz": "Sahihi Buxoriy",
            "mediaUrl": null,
            "collection": "bukhari",
            "translationUz": "Musulmon — boshqa musulmonlar uning tili va qo‘lidan omonda bo‘lgan kishidir.\n\nManba: Sahih al-Buxoriy, 10-hadis.",
            "createdBy": "menageradmin",
