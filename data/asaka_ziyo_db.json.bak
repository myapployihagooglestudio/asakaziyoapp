        "mediaPosts": [],
        "hadiths": [
          {
            "id": "h-1793878613983",
            "narratorUz": "Roviy: Umar ibn Xattob (r.a.)",
            "syncedAt": "2026-11-21T19:58:24.636Z",
            "number": 1,
            "textAr": "Amallar niyatga bog‘liq\nإِنَّمَا الْأَعْمَالُ بِالنِّيَّاتِ",
            "publishMode": "published",
            "reference": "bukhari, 1-hadis",
            "updatedAt": "2026-11-21T19:58:24.636Z",
            "mediaUrl": null,
            "collectionNameUz": "Sahihi Buxoriy",
            "chapterUz": "Moʻtabar hadislar bobi",
            "isArchived": false,
            "adminEmail": "asakaziyo0@gmail.com",
            "mediaType": null,
            "translationUz": "Albatta, amallar niyatlarga bog‘liqdir. Har bir kishiga niyat qilgan narsasi bo‘ladi.\nManba: Sahih al-Buxoriy, 1-hadis.",
            "grade": "Sahih",
            "collection": "bukhari",
            "createdAtIso": "2026-11-05T11:36:53.983Z",
