                ],
                "difficulty": "oson",
                "sourceVerified": true,
                "questionUz": "Paygʻambarimizning (s.a.v.) ikki qizlariga (Ruqayya va Ummu Kulsumga) uylanganlari uchun «Zunnurayn» (ikki nur sohibi) unvonini olgan sahoba kim?",
                "id": "q-031",
                "publishedDate": "2026-11-05",
                "correctIndex": 1,
                "category": "Sahobalar",
                "status": "approved",
