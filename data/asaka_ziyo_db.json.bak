        "announcements": [
          {
            "id": "ann-1794331680173",
            "isArchived": false,
            "type": "masjid",
            "typeLabelUz": "Muhim",
            "adminEmail": "asakaziyo0@gmail.com",
            "date": "10/11/2026",
            "schemaVersion": 1,
            "updatedBy": "menageradmin",
            "createdAt": "2026-11-10T17:28:00.174Z",
            "publishMode": "published",
            "description": "Бисмиллаҳир роҳманир роҳийм!\n\nМуборак Жумодус соний ойи кириб келиши муносабати билан барча мўмин-мусулмонларни самимий муборакбод этамиз. Аллоҳ таоло ушбу ойни барчамиз учун хайрли, баракали ва эзгу амалларга бой айласин!\n\nАзиз юртдошлар, қадрли мўмин-мусулмонлар!\n\nБарчангизни ҳижрий-қамарий тақвимнинг муборак ойларидан бири — Жумодус соний ойи кириб келиши муносабати билан чин қалбимиздан муборакбод этамиз!\n\nЯнги ҳижрий ой — инсон учун ўз қалбини поклаш, эзгу ниятлар қилиш, хайрли амалларга интилиш ва Аллоҳ таолога янада яқин бўлиш учун гўзал бир фурсатдир.\n\nУшбу муборак ойда барчамизга мустаҳкам иймон, қалб хотиржамлиги, оилавий бахт, соғлик-саломатлик ва баракали ризқ насиб этсин.\n\nАллоҳ таоло қилаётган ибодатларимизни, дуоларимизни ва эзгу амалларимизни даргоҳида қабул айласин. Юртимизга тинчлик, хонадонларимизга файзу барака, қалбларимизга меҳр-оқибат ато этсин!\n\nЖумодус соний ойи барчамизга муборак бўлсин!\n\nФалакий ҳисобга кўра, ҳижрий 1448 йил\nЖумодус соний ойининг 1-куни  2026 йил 11 ноябрь чоршанба кунига тўғри келмоқда.\n\nПайғамбаримиз соллаллоҳу алайҳи васаллам қачон янги чиққан ойни кўрсалар шундай дуо қилардилар: \n\"اللَّهُمَّ أَهِلَّهُ عَلَيْنَا بِالْيُمْنِ وَالْإِيمَانِ وَالسَّلَامَةِ وَالْإِسْلَامِ رَبِّي وَرَبُّكَ اللهُ\"\n\nЎқилиши: \"Аллоҳумма аҳиллаҳу алайна бил-юмни вал-иймани, вас-салаамати вал-Ислами, Роббий ва Роббукаллоҳ”.\n\nМаъноси: \"Эй, Аллоҳим!  Бу ойни бизларга барака ва имон, саломатлик ва Ислом ойи қилгин! Эй, ҳилол, менинг ҳам, сенинг ҳам Роббинг Аллоҳдир!\".\n\nҲурмат ва эҳтиром билан,\nASAKA ZIYO жамоаси\n\nИслом билан, ҳаёт янада нурли! 🤲",
            "createdBy": "menageradmin",
            "updatedAt": "2026-11-10T17:28:00.174Z",
            "isPinned": true,
            "mediaType": "image",
            "title": "Жумодус соний ойи муборак бўлсин! Барчангизга тинчлик ва барака тилаймиз",
            "createdAtIso": "2026-11-10T17:28:00.173Z",
            "location": "Asaka Ziyo maʼmuriyati",
            "mediaUrl": "/uploads/1794331611998_file_00000000ec5882469b45ff252a6c0dbf.png",
            "syncedAt": "2026-11-10T17:28:00.174Z",
            "_serverSyncedAt": "2026-11-10T17:28:01.766Z"
          }
        ],
        "news": [
          {
            "id": "news-1794331326611",
            "updatedBy": "menageradmin",
            "source": "Asaka Ziyo Axborot Xizmati",
            "createdAtIso": "2026-11-10T17:22:06.631Z",
            "summary": "Муборак Жумодус соний ойи кириб келиши муносабати билан барча мўмин-мусулмонларни самимий муборакбод этамиз. Аллоҳ таоло ушбу ойни барчамиз учун хайрли, баракали ва эзгу амалларга бой айласин!",
            "publishedDate": "10/11/2026",
            "createdAt": "2026-11-10T17:22:06.635Z",
            "schemaVersion": 1,
            "_serverSyncedAt": "2026-11-10T17:22:07.512Z",
            "content": "Бисмиллаҳир роҳманир роҳийм!\n\nАзиз юртдошлар, қадрли мўмин-мусулмонлар!\n\nБарчангизни ҳижрий-қамарий тақвимнинг муборак ойларидан бири — Жумодус соний ойи кириб келиши муносабати билан чин қалбимиздан муборакбод этамиз!\n\nЯнги ҳижрий ой — инсон учун ўз қалбини поклаш, эзгу ниятлар қилиш, хайрли амалларга интилиш ва Аллоҳ таолога янада яқин бўлиш учун гўзал бир фурсатдир.\n\nУшбу муборак ойда барчамизга мустаҳкам иймон, қалб хотиржамлиги, оилавий бахт, соғлик-саломатлик ва баракали ризқ насиб этсин.\n\nАллоҳ таоло қилаётган ибодатларимизни, дуоларимизни ва эзгу амалларимизни даргоҳида қабул айласин. Юртимизга тинчлик, хонадонларимизга файзу барака, қалбларимизга меҳр-оқибат ато этсин!\n\nЖумодус соний ойи барчамизга муборак бўлсин!\n\nҲурмат ва эҳтиром билан,\nASAKA ZIYO жамоаси\n\nИслом билан, ҳаёт янада нурли! 🤲",
            "adminEmail": "asakaziyo0@gmail.com",
            "isArchived": false,
            "mediaType": "image",
            "publishMode": "published",
            "updatedAt": "2026-11-10T17:22:06.635Z",
