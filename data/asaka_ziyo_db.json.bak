                "category": "Zikr va Duolar",
                "reference": "Buxoriy 6405-hadis; Muslim 2691-hadis",
                "isApproved": true,
                "optionsUz": [
                  "Barcha qarzlaridan qutiladi",
                  "Dengiz koʻpigicha boʻlsa ham gunohlari kechiriladi",
                  "Unga 100 ta qul ozod qilgan savobi yoziladi",
