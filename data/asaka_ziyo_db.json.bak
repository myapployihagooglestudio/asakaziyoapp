          },
          {
            "id": "h-1793878860475",
            "publishMode": "published",
            "narratorUz": "Roviy: Abdulloh ibn Amr (r.a.)",
            "textAr": "الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ",
            "number": 10,
            "chapterUz": "Moʻtabar hadislar bobi",
            "createdAtIso": "2026-11-05T11:41:00.475Z",
            "updatedAt": "2026-11-21T07:01:38.402Z",
            "reference": "bukhari, 10-hadis",
            "keywords": [
              "hadis",
              "hikmat",
              "sunnat"
            ],
            "isArchived": false,
            "grade": "Sahih",
            "mediaType": null,
            "syncedAt": "2026-11-21T07:01:38.402Z",
            "adminEmail": "asakaziyo0@gmail.com",
            "collectionNameUz": "Sahihi Buxoriy",
            "mediaUrl": null,
            "collection": "bukhari",
            "translationUz": "Musulmon — boshqa musulmonlar uning tili va qo‘lidan omonda bo‘lgan kishidir.\n\nManba: Sahih al-Buxoriy, 10-hadis.",
            "createdBy": "menageradmin",
            "updatedBy": "menageradmin",
            "schemaVersion": 1,
            "_serverSyncedAt": "2026-11-21T07:01:37.843Z",
