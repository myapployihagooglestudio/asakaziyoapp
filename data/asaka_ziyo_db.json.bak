            "updatedAt": "2026-11-21T19:58:28.098Z",
            "publishMode": "published",
            "categoryTitleUz": "Zikr va Tasbeh",
            "createdAtIso": "2026-11-05T11:44:30.726Z",
            "titleUz": "Subhanallohi va bihamdihi",
            "source": "Moʻtabar manbalardan",
            "isArchived": false,
            "adminEmail": "asakaziyo0@gmail.com",
            "category": "namozdan_keyin",
            "translationUz": "Allohni hamd aytish bilan poklab yod etaman.",
