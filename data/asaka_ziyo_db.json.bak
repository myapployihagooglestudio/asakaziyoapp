        "dhikrs": [
          {
            "id": "d-1793878988701",
            "categoryTitleUz": "Zikr va Tasbeh",
            "titleUz": "Sayyidul istig‘for",
            "translationUz": "Ey Alloh! Sen mening Rabbimsan. Sendan boshqa iloh yo‘q. Meni Sen yaratding va men Sening bandangman. Imkonim boricha Senga bergan ahdim va va'damda turaman. Qilgan ishlarimning yomonligidan Sening panohingga qochaman. Menga bergan ne'matlaringni e'tirof etaman va gunohlarimni ham tan olaman. Meni mag‘firat qil. Albatta, gunohlarni Sendan boshqa hech kim kechirmaydi.",
            "updatedAt": "2026-11-10T06:54:48.095Z",
            "syncedAt": "2026-11-10T06:54:48.095Z",
            "createdAtIso": "2026-11-05T11:43:08.701Z",
            "publishMode": "published",
            "adminEmail": "asakaziyo0@gmail.com",
            "virtueUz": "Qalbga xotirjamlik va ulugʻ ajr keltiruvchi muborak zikr.",
            "mediaType": null,
            "isArchived": false,
            "targetCount": 33,
            "source": "Moʻtabar manbalardan",
            "mediaUrl": null,
            "textAr": "اللَّهُمَّ أَنْتَ رَبِّي لَا إِلَهَ إِلَّا أَنْتَ، خَلَقْتَنِي وَأَنَا عَبْدُكَ، وَأَنَا عَلَى عَهْدِكَ وَوَعْدِكَ مَا اسْتَطَعْتُ، أَعُوذُ بِكَ مِنْ شَرِّ مَا صَنَعْتُ، أَبُوءُ لَكَ بِنِعْمَتِكَ عَلَيَّ، وَأَبُوءُ بِذَنْبِي، فَاغْفِرْ لِي، فَإِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ",
            "category": "sayyidul_istigfor",
            "transliterationUz": "",
            "createdAt": "2026-11-08T23:33:12.783Z",
            "_serverSyncedAt": "2026-11-10T06:54:49.267Z",
            "updatedBy": "menageradmin",
            "schemaVersion": 1,
            "createdBy": "menageradmin"
          },
          {
            "id": "d-1793879070726",
