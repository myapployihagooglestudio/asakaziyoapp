                  "Isro surasi, 23-oyat",
                  "Luqmon surasi, 14-oyat",
                  "Niso surasi, 36-oyat",
                  "Ahqof surasi, 15-oyat"
                ],
                "status": "approved",
                "publishedDate": "2026-11-02",
                "id": "q-014"
              }
