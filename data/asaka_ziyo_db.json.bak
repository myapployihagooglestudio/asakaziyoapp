                "difficulty": "oson",
                "isApproved": true,
                "explanationUz": "Hazrati Bilol ibn Raboh roziyallohu anhu islom tarixidagi eng birinchi muazzin boʻlib, yoqimli va jarangdor ovozlari bilan azon aytganlar.",
                "status": "approved",
