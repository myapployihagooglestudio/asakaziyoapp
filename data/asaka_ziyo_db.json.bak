                  "Zubayr ibn Avvom (r.a.)"
                ],
                "correctIndex": 1,
                "sourceVerified": true,
                "difficulty": "oson",
                "status": "approved",
                "category": "Sahobalar",
                "reference": "Xulafoyi Roshidin: Usmon ibn Affon bobi",
                "id": "q-031",
