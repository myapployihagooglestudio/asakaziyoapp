                "isApproved": true,
                "status": "approved",
                "questionUz": "Vahiy kotibi boʻlgan va Hazrati Abu Bakr hamda Usmon (r.a.) davrlarida Qurʼoni Karimni jamlash ishiga boshchilik qilgan sahoba kim?",
                "sourceVerified": true
              },
