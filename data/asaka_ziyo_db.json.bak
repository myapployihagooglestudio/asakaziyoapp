            "updatedBy": "menageradmin",
            "createdBy": "menageradmin"
          },
          {
            "id": "h-1793878758294",
            "adminEmail": "asakaziyo0@gmail.com",
            "isArchived": false,
            "syncedAt": "2026-11-20T13:47:06.082Z",
            "collection": "bukhari",
            "updatedAt": "2026-11-20T13:47:06.082Z",
            "reference": "bukhari, 13-hadis",
            "mediaUrl": null,
            "chapterUz": "Moʻtabar hadislar bobi",
            "publishMode": "published",
            "createdAtIso": "2026-11-05T11:39:18.294Z",
            "narratorUz": "Roviy: Anas ibn Molik (r.a.)",
            "collectionNameUz": "Sahihi Buxoriy",
            "mediaType": null,
            "keywords": [
              "hadis",
              "hikmat",
              "sunnat"
            ],
            "textAr": "لَا يُؤْمِنُ أَحَدُكُمْ حَتَّى يُحِبَّ لِأَخِيهِ مَا يُحِبُّ لِنَفْسِهِ",
            "number": 13,
            "grade": "Sahih",
            "translationUz": "Sizlardan biringiz o‘zi uchun yaxshi ko‘rgan narsani birodari uchun ham yaxshi ko‘rmagunicha komil mo‘min bo‘la olmaydi.\n\nManba: Sahih al-Buxoriy, 13; Sahih Muslim, 45.",
            "createdAt": "2026-11-08T22:48:37.687Z",
            "createdBy": "menageradmin",
            "schemaVersion": 1,
            "_serverSyncedAt": "2026-11-20T13:47:05.606Z",
            "updatedBy": "menageradmin"
          },
          {
            "id": "h-1793878860475",
            "publishMode": "published",
            "narratorUz": "Roviy: Abdulloh ibn Amr (r.a.)",
            "textAr": "الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ",
            "number": 10,
            "chapterUz": "Moʻtabar hadislar bobi",
            "createdAtIso": "2026-11-05T11:41:00.475Z",
