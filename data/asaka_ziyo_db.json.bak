                "reference": "Isro surasi, 23-oyat",
                "status": "approved",
                "optionsUz": [
                  "Isro surasi, 23-oyat",
                  "Luqmon surasi, 14-oyat",
                  "Niso surasi, 36-oyat",
                  "Ahqof surasi, 15-oyat"
