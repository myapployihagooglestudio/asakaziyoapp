            "imageUrl": "/images/quran_illumination_art_1793634658336.jpg",
            "title": "Yangi ilmiy maqola: Дунёда шундай бир жаннат борки, ким унга кирмаса, охират жаннатига ҳам кирмайди",
            "body": "Asaka Ziyo",
            "syncedAt": "2026-11-10T12:07:02.294Z",
            "createdBy": "menageradmin",
            "updatedAt": "2026-11-10T12:07:02.294Z",
            "_serverSyncedAt": "2026-11-10T12:07:06.185Z",
