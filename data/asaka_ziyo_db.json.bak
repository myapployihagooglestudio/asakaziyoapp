                  "Bismillahi tavakkaltu alalloh",
                  "Subhanallohi val hamdu lillah"
                ],
                "source": "Sahihi Muslim",
                "reference": "Musofirlar namozi kitobi, 713-hadis",
                "sourceVerified": true,
                "id": "q-030",
                "status": "approved",
                "correctIndex": 1,
