                "isApproved": true,
                "sourceVerified": true,
                "id": "q-027",
                "difficulty": "orta",
                "questionUz": "Quyosh chiqayotgan, qiyomga kelgan va botayotgan paytlarda namoz oʻqish hukmi qanday?",
                "status": "approved",
