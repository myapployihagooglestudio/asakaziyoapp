                ]
              },
              {
                "status": "approved",
                "reference": "1-juz, Fotiha surasi muqaddimasi",
                "difficulty": "oson",
                "questionUz": "Qurʼoni Karimning qaysi surasi «Qurʼonning onasi» (Ummul Qurʼon) deb ataladi?",
                "sourceVerified": true,
                "optionsUz": [
                  "Baqara surasi",
                  "Fotiha surasi",
                  "Yosin surasi",
                  "Ixlos surasi"
                ],
                "isApproved": true,
