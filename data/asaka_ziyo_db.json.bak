                "status": "approved",
                "source": "Ibn Hishom, As-Siyratun Nabaviya",
                "isApproved": true,
                "questionUz": "Paygʻambarimiz (s.a.v.) Ahzob jangi oldidan Madinani himoya qilish uchun xandaq qazish fikrini qaysi sahobaning taklifi bilan qabul qilganlar?",
                "id": "q-015",
