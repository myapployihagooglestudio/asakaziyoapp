  "tajweedLessons": {
    "tajweed-01-nun-sakin": {
      "id": "tajweed-01-nun-sakin",
      "level": "beginner",
      "order": 1,
      "titleUz": "Sokin Nun va Tanvin qoidalari (Izhor, Idgʻom, Iqlob, Ixfo)",
      "titleAr": "أحكام النون الساكنة والتنوين",
      "ruleCategoryUz": "Sokin Nun va Tanvin",
      "summaryUz": "Qurʼon tilovatining eng muhim 4 ta asosiy qoidasi: Izhor, Idgʻom, Iqlob va Ixfo.",
      "contentUz": "Sokin nun (نْ) yoki tanvindan (ً ٍ ٌ) keyin keladigan harfga qarab 4 xil hukm qoʻllanadi:\n1. Izhor (Aniq oʻqish): 6 ta halqum harfi (ء ه ع ح غ خ) kelganda nun aniq va gʻunnasiz oʻqiladi.\n2. Idgʻom (Kiritib yuborish): ي ر م ل و ن harflarida — ي ن م و bilan gʻunnali, ل ر bilan gʻunnasiz qoʻshiladi.\n3. Iqlob (Almashtirish): ب harfi kelganda nun tovushi yashirin mim (م) ga aylanib 2 harakat gʻunna qilinadi.\n4. Ixfo (Yashirish): Qolgan 15 ta harfda nun tovushi izhor va idgʻom orasida 2 harakat gʻunna bilan oʻqiladi.",
      "examples": [
        {
          "arabic": "مِنْ خَوْفٍ",
          "readingUz": "Min xovfin",
          "ruleNoteUz": "Izhor: خ halqum harfi kelgani uchun nun aniq oʻqiladi."
        },
        {
          "arabic": "مَن يَعْمَلْ",
          "readingUz": "May-yaʼmal",
          "ruleNoteUz": "Idgʻom bi-gʻunna: nun ي harfiga dimogʻ ovozi bilan kiritiladi."
        },
        {
          "arabic": "مِن بَعْدِ",
          "readingUz": "Mim-baʼdi",
          "ruleNoteUz": "Iqlob: ب oldidan sokin nun mim ga aylanadi."
        },
        {
          "arabic": "مِن شَرِّ",
          "readingUz": "Min sharri (ixfo)",
          "ruleNoteUz": "Ixfo: ش harfi oldida nun yashirilib 2 harakat gʻunna qilinadi."
        }
      ],
      "teacherName": "ASAKA ZIYO Tajvid Ustozlari",
      "durationMinutes": 12,
      "isPremium": false,
      "isPublished": true,
      "createdAt": "2026-11-25T05:12:03.044Z",
      "updatedAt": "2026-11-25T05:12:03.044Z"
    },
    "tajweed-02-qalqala": {
      "id": "tajweed-02-qalqala",
      "level": "beginner",
      "order": 2,
      "titleUz": "Qalqala harflari va darajalari (ق ط ب ج د)",
      "titleAr": "أحكام القلقلة",
      "ruleCategoryUz": "Qalqala",
      "summaryUz": "Qutbu Jaddin (ق ط ب ج د) harflari sokin boʻlganda tovushning tebranib chiqish qoidasi.",
      "contentUz": "Qalqala harflari 5 ta: ق، ط، ب، ج، د (\"Qutbu Jaddin\" jumlasida jamlangan).\nUlar sokin (sukunli) holatda kelganda maxrajda tovush tiqilib qolmasligi uchun yengil aks-sado (tebranish) bilan oʻqiladi.\n• Qalqalai Sugʻro (Kichik): Soʻz oʻrtasida kelganda (masalan: يَجْعَلُونَ).\n• Qalqalai Kubro (Katta): Oyat oxirida vaqf qilinganda (masalan: قُلْ هُوَ اللَّهُ أَحَدٌ).",
      "examples": [
        {
          "arabic": "قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ",
          "readingUz": "Al-Falaq",
          "ruleNoteUz": "Oyat oxirida ق harfida Qalqalai Kubro qilinadi."
        },
        {
          "arabic": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
          "readingUz": "Yalid · Yulad",
          "ruleNoteUz": "د harfida aniq tebranish bilan toʻxtaladi."
        }
      ],
      "teacherName": "ASAKA ZIYO Tajvid Ustozlari",
      "durationMinutes": 9,
      "isPremium": false,
      "isPublished": true,
      "createdAt": "2026-11-25T05:12:03.044Z",
      "updatedAt": "2026-11-25T05:12:03.044Z"
    },
    "tajweed-03-mim-sakin": {
      "id": "tajweed-03-mim-sakin",
      "level": "beginner",
      "order": 3,
      "titleUz": "Sokin Mim qoidalari (Ixfo Shafaviy, Idgʻom Mislayn, Izhor Shafaviy)",
      "titleAr": "أحكام الميم الساكنة",
      "ruleCategoryUz": "Sokin Mim",
      "summaryUz": "Sokin mim (مْ) dan keyin ب, م yoki boshqa harflar kelgandagi talaffuz tartibi.",
      "contentUz": "Sokin mim (مْ) uch holatda oʻqiladi:\n1. Idgʻom Mislayn (Shafaviy): Sokin mimdan keyin harakatli م kelsa, ikki mim birlashtirilib 2 harakat gʻunna qilinadi.\n2. Ixfo Shafaviy: Sokin mimdan keyin ب kelsa, lablar yengil tegib 2 harakat gʻunna bilan oʻqiladi.\n3. Izhor Shafaviy: Qolgan 26 harfda mim aniq va choʻzmasdan oʻqiladi (ayniqsa و va ف oldidan ehtiyot boʻlinadi).",
      "examples": [
        {
          "arabic": "تَرْمِيهِم بِحِجَارَةٍ",
          "readingUz": "Tarmiyhim bi-hijarotin",
          "ruleNoteUz": "Ixfo Shafaviy: مْ dan keyin ب keldi."
        },
        {
          "arabic": "لَهُم مَّغْفِرَةٌ",
          "readingUz": "Lahum-magʻfirotun",
