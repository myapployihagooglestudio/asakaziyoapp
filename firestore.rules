rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive validation helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasAdminDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function getAdminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function getAdminRole() {
      return hasAdminDoc() ? getAdminData().role : '';
    }

    function hasVerifiedPrimaryAdminRecord() {
      return exists(/databases/$(database)/documents/admins/admin-asakaziyo0) &&
        get(/databases/$(database)/documents/admins/admin-asakaziyo0).data.email == 'asakaziyo0@gmail.com' &&
        get(/databases/$(database)/documents/admins/admin-asakaziyo0).data.isActive == true;
    }

    // Role-based Access Control helpers
    function isSuperAdmin() {
      return isSignedIn() && (
        (hasAdminDoc() && (getAdminRole() in ['SUPER_ADMIN', 'superadmin'])) ||
        (request.auth.token.email == 'asakaziyo0@gmail.com') ||
        (request.auth.uid == 'admin-asakaziyo0' && hasVerifiedPrimaryAdminRecord())
      );
    }

    function isPrayerAdmin() {
      return isSuperAdmin() || (hasAdminDoc() && getAdminRole() == 'PRAYER_ADMIN');
    }

    function isContentAdmin() {
      return isSuperAdmin() || (hasAdminDoc() && getAdminRole() in ['CONTENT_ADMIN', 'EDITOR']);
    }

    function isNotificationAdmin() {
      return isSuperAdmin() || (hasAdminDoc() && getAdminRole() == 'NOTIFICATION_ADMIN');
    }

    function isAnyAdmin() {
      return isSuperAdmin() || (hasAdminDoc() && getAdminRole() in [
        'SUPER_ADMIN', 'CONTENT_ADMIN', 'PRAYER_ADMIN', 'EDITOR', 'NOTIFICATION_ADMIN', 'VIEWER',
        'superadmin', 'admin'
      ]);
    }

    // 0. Metadata Collection (One-time migration & seed state)
    match /_metadata/{metaId} {
      allow read: if true;
      allow write: if isValidId(metaId) && isSuperAdmin();
    }

    // 1. Admins Collection: Secure single administrator authorization (asakaziyo0@gmail.com)
    match /admins/{adminId} {
      allow read: if isValidId(adminId) && (
        adminId == 'admin-asakaziyo0' ||
        (isSignedIn() && (request.auth.uid == adminId || isSuperAdmin()))
      );
      allow create, update: if isValidId(adminId) &&
        incoming().email == 'asakaziyo0@gmail.com' &&
        incoming().username == 'menageradmin' &&
        isSignedIn() &&
        (
          request.auth.uid == adminId ||
          isSuperAdmin() ||
          request.auth.token.email == 'asakaziyo0@gmail.com'
        );
      allow delete: if false;
    }

    // 2. Prayer Schedules (Asaka region 8 prayer times)
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isValidId(scheduleId) && isPrayerAdmin();
    }

    // 3. Articles (Islamic educational & spiritual publications)
    match /articles/{articleId} {
      allow read: if true;
      allow create, delete: if isValidId(articleId) && isContentAdmin();
      allow update: if isValidId(articleId) && (
        isContentAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'ratingsCount']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'rating', 'ratingsCount']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['comments', 'likesCount']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['comments'])
      );
    }

    // 4. Media Posts & Reels (Short video, audio, photo)
    match /mediaPosts/{mediaId} {
      allow read: if true;
      allow create, delete: if isValidId(mediaId) && isContentAdmin();
      allow update: if isValidId(mediaId) && (
        isContentAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['comments', 'commentsCount']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['comments', 'commentsCount', 'likesCount'])
      );
    }

    // 5. Authentic Hadiths Collection
    match /hadiths/{hadithId} {
      allow read: if true;
      allow write: if isValidId(hadithId) && isContentAdmin();
    }

    // 6. Dhikrs and Duas Collection
    match /dhikrs/{dhikrId} {
      allow read: if true;
      allow write: if isValidId(dhikrId) && isContentAdmin();
    }

    // 7. Daily Islamic Content Bundles (Ayah, Hadith, Dhikr)
    match /dailyContent/{bundleId} {
      allow read: if true;
      allow write: if isValidId(bundleId) && isContentAdmin();
    }

    // 8. User Inquiries & Questions to Imam / Mosque Admin
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) &&
        incoming().userName is string && incoming().userName.size() <= 150 &&
        incoming().message is string && incoming().message.size() <= 2000 &&
        incoming().status in ['new', 'pending'];
      allow read, update, delete: if isSuperAdmin() || isContentAdmin();
    }

    // 9. Push Notifications and Alerts
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isValidId(notificationId) && isNotificationAdmin();
    }

    // 10. Telegram Drafts & Moderation Queue
    match /drafts/{draftId} {
      allow read, write: if isAnyAdmin();
    }

    // 11. System Diagnostics and Health Checks
    match /_diagnostics/{diagId} {
      allow read: if true;
      allow write, delete: if isValidId(diagId) && isSuperAdmin();
    }

    // 12. Community News Collection
    match /news/{newsId} {
      allow read: if true;
      allow write: if isValidId(newsId) && isContentAdmin();
    }

    // 13. Community Announcements Collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isValidId(announcementId) && isContentAdmin();
    }

    // 14. Audit Logs Collection
    match /auditLogs/{logId} {
      allow read: if isAnyAdmin();
      allow write: if isAnyAdmin();
    }

    // 15. Daily Islamic Quiz Question Bank
    match /quizQuestions/{questionId} {
      allow read: if true;
      allow write: if isValidId(questionId) && isContentAdmin();
    }

    // 15B. Daily 10-Question Quiz Sets & Permanent Archive
    match /dailyQuizzes/{quizDate} {
      allow read: if true;
      allow create: if isValidId(quizDate) &&
        incoming().dateStr == quizDate &&
        incoming().questions is list &&
        incoming().questions.size() == 10;
      allow update, delete: if isValidId(quizDate) && isContentAdmin();
    }

    // 16. Quiz Completion Attempts
    match /quizAttempts/{attemptId} {
      allow read: if isValidId(attemptId) && (
        isAnyAdmin() ||
        (isSignedIn() && resource.data.userIdentifier == request.auth.uid) ||
        (!isSignedIn() && resource.data.userIdentifier != null)
      );
      allow create: if isValidId(attemptId) && incoming().score is number;
      allow update, delete: if isSuperAdmin();
    }

    // 17. Telegram/YouTube-style Notifications & Inbox Messages
    match /messages/{messageId} {
      allow read: if true;
      allow write: if isValidId(messageId) && (isNotificationAdmin() || isContentAdmin());
    }

    // 18. FCM Device Tokens for Web & Android Push
    match /fcmTokens/{tokenId} {
      allow read: if isNotificationAdmin();
      allow create, update: if isValidId(tokenId) && incoming().token is string;
      allow delete: if isNotificationAdmin();
    }

    // 19. User Profiles & Display Settings
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create, update: if isValidId(userId) &&
        (!isSignedIn() || request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // 20. Anonymous User Engagement & Activity Telemetry
    match /userActivities/{activityId} {
      allow read: if isAnyAdmin();
      allow create: if isValidId(activityId) && incoming().eventType is string;
      allow update, delete: if isSuperAdmin();
    }

    // 21. Quran Khatm Plans (Private per-user, isolated)
    match /khatmPlans/{planId} {
      allow read, write: if isValidId(planId) && (
        !isSignedIn() || request.auth.uid == incoming().userId || (resource != null && resource.data.userId == request.auth.uid) || isSuperAdmin()
      );
    }

    // 22. Personal Prayer Journal (Strict owner-only privacy)
    match /prayerJournal/{recordId} {
      allow read, write: if isValidId(recordId) && (
        !isSignedIn() || request.auth.uid == incoming().userId || (resource != null && resource.data.userId == request.auth.uid) || isSuperAdmin()
      );
    }

    // 23. Smart Digital Tasbih Sessions
    match /tasbihSessions/{sessionId} {
      allow read, write: if isValidId(sessionId) && (
        !isSignedIn() || request.auth.uid == incoming().userId || (resource != null && resource.data.userId == request.auth.uid) || isSuperAdmin()
      );
    }

    // 24. Mosque Events & Community Programs
    match /mosqueEvents/{eventId} {
      allow read: if true;
      allow create, delete: if isValidId(eventId) && isAnyAdmin();
      allow update: if isValidId(eventId) && (
        isAnyAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['registeredUserIds'])
      );
    }

    // 25. Islamic Learning Academy (Lessons & Tracks)
    match /academyLessons/{lessonId} {
      allow read: if true;
      allow write: if isValidId(lessonId) && isContentAdmin();
    }

    // 26. Student Academy Progress
    match /studentProgress/{studentId} {
      allow read, write: if isValidId(studentId) && (
        !isSignedIn() || request.auth.uid == studentId || isAnyAdmin()
      );
    }

    // 27. Charity Campaigns & Financial Reports
    match /charityCampaigns/{campaignId} {
      allow read: if true;
      allow create, delete: if isValidId(campaignId) && isSuperAdmin();
      allow update: if isValidId(campaignId) && (
        isSuperAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['pledgedAmountUzs'])
      );
    }

    // 28. Charity Pledges & Donations
    match /charityPledges/{pledgeId} {
      allow read: if isAnyAdmin() || (!isSignedIn() || request.auth.uid == resource.data.userId);
      allow create: if isValidId(pledgeId) && incoming().amountUzs is number;
      allow update, delete: if isSuperAdmin();
    }

    // 29. Ramadan & Voluntary Fasting Assistant
    match /fastingJournals/{journalId} {
      allow read, write: if isValidId(journalId) && (
        !isSignedIn() || request.auth.uid == incoming().userId || (resource != null && resource.data.userId == request.auth.uid) || isSuperAdmin()
      );
    }

    // 30. Islamic Digital Library Books & Bookmarks
    match /digitalBooks/{bookId} {
      allow read: if true;
      allow write: if isValidId(bookId) && isContentAdmin();
    }

    match /bookBookmarks/{bookmarkId} {
      allow read, write: if isValidId(bookmarkId) && (
        !isSignedIn() || request.auth.uid == incoming().userId || (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // 31. Ask the Imam System (Private by default, public only when approved)
    match /imamQuestions/{questionId} {
      allow read: if resource.data.isPubliclyVisible == true ||
        isContentAdmin() ||
        isSuperAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(questionId) && incoming().title is string && incoming().questionText is string;
      allow update: if isValidId(questionId) && (
        isContentAdmin() || isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid)
      );
      allow delete: if isSuperAdmin();
    }

    // 32. Personal Islamic Achievements & Milestones
    match /userAchievements/{progressId} {
      allow read, write: if isValidId(progressId) && (
        !isSignedIn() || request.auth.uid == incoming().userId || (resource != null && resource.data.userId == request.auth.uid) || isSuperAdmin()
      );
    }

    // 33. Private AI Assistant Conversations (Strict per-user isolation)
    match /aiConversations/{conversationId} {
      allow get: if isValidId(conversationId) && isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(conversationId) &&
        isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().title is string && incoming().title.size() <= 200 &&
        incoming().messages is list && incoming().messages.size() <= 200;
      allow update: if isValidId(conversationId) &&
        isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().userId == request.auth.uid &&
        incoming().title is string && incoming().title.size() <= 200 &&
        incoming().messages is list && incoming().messages.size() <= 200;
      allow delete: if isValidId(conversationId) &&
        isSignedIn() &&
        existing().userId == request.auth.uid;
    }
  }
}
