rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive validation helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-.:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasAdminDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function getAdminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function getAdminRole() {
      return hasAdminDoc() ? getAdminData().role : '';
    }

    function hasVerifiedPrimaryAdminRecord() {
      return exists(/databases/$(database)/documents/admins/admin-asakaziyo0) &&
        get(/databases/$(database)/documents/admins/admin-asakaziyo0).data.email == 'asakaziyo0@gmail.com' &&
        get(/databases/$(database)/documents/admins/admin-asakaziyo0).data.isActive == true;
    }

    // Cryptographic Server-Gate Atomic Batch Verification:
    // Allows the authenticated Express backend (after verifying PBKDF2-SHA512 / HMAC admin session)
    // to commit privileged writes atomically alongside an unreadable server gate lock document
    // without exposing any secret to clients or opening public write access.
    function isVerifiedServerWrite(colName, docId) {
      let lockPath = /databases/$(database)/documents/_server_gate/lock;
      let vaultV4 = /databases/$(database)/documents/_server_vault/master_key_v4;
      let vaultV3 = /databases/$(database)/documents/_server_vault/master_key_v3;
      let afterLock = getAfter(lockPath).data;
      return existsAfter(lockPath) &&
        afterLock.targetCollection == colName &&
        afterLock.targetDocId == docId &&
        (!exists(lockPath) || get(lockPath).data.batchId != afterLock.batchId) &&
        (
          (exists(vaultV4) && afterLock.serverSecret == get(vaultV4).data.secret) ||
          (!exists(vaultV4) && exists(vaultV3) && afterLock.serverSecret == get(vaultV3).data.secret)
        );
    }

    // Role-based Access Control helpers
    function isSuperAdmin() {
      return isSignedIn() && (
        (hasAdminDoc() && (getAdminRole() in ['SUPER_ADMIN', 'superadmin'])) ||
        ((request.auth.token.email == 'asakaziyo0@gmail.com' || request.auth.token.email == 'mirzayevulugbek024@gmail.com') && request.auth.token.email_verified == true) ||
        (request.auth.uid == 'admin-asakaziyo0' && hasVerifiedPrimaryAdminRecord())
      );
    }

    function isPrayerAdmin() {
      return isSuperAdmin() || (hasAdminDoc() && getAdminRole() in ['PRAYER_ADMIN', 'PRAYER_TIMES_MANAGER', 'ADMIN']);
    }

    function isContentAdmin() {
      return isSuperAdmin() || (hasAdminDoc() && getAdminRole() in ['CONTENT_ADMIN', 'CONTENT_MANAGER', 'EDITOR', 'QURAN_AUDIO_MANAGER', 'ADMIN']);
    }

    function isNotificationAdmin() {
      return isSuperAdmin() || (hasAdminDoc() && getAdminRole() in ['NOTIFICATION_ADMIN', 'MODERATOR', 'ADMIN']);
    }

    function isAnyAdmin() {
      return isSuperAdmin() || (hasAdminDoc() && getAdminRole() in [
        'SUPER_ADMIN', 'ADMIN', 'CONTENT_ADMIN', 'CONTENT_MANAGER', 'PRAYER_ADMIN', 'PRAYER_TIMES_MANAGER',
        'QURAN_AUDIO_MANAGER', 'EDITOR', 'MODERATOR', 'ANALYST', 'NOTIFICATION_ADMIN', 'VIEWER',
        'superadmin', 'admin'
      ]);
    }

    // 0A. Unreadable Server Master Key Vault (Strictly unreadable by any client)
    match /_server_vault/{vaultId} {
      allow read: if false;
      allow create: if (vaultId == 'master_key' || vaultId == 'master_key_v2' || vaultId == 'master_key_v3' || vaultId == 'master_key_v4') &&
        !exists(/databases/$(database)/documents/_server_vault/$(vaultId)) &&
        incoming().keys().hasAll(['secret', 'createdAt']) &&
        incoming().keys().hasOnly(['secret', 'createdAt']) &&
        incoming().secret is string &&
        incoming().secret.size() >= 64 &&
        incoming().secret.size() <= 256 &&
        incoming().createdAt is string &&
        incoming().createdAt.size() <= 64;
      allow update: if (vaultId == 'master_key' || vaultId == 'master_key_v2' || vaultId == 'master_key_v3' || vaultId == 'master_key_v4') && (
        isSuperAdmin() ||
        (incoming().previousSecret is string &&
         incoming().previousSecret == existing().secret &&
         incoming().secret is string &&
         incoming().secret.size() >= 64 &&
         incoming().secret.size() <= 256)
      );
      allow delete: if false;
    }

    // 0B. Unreadable Server Atomic Batch Gate (Strictly unreadable by any client)
    match /_server_gate/{gateId} {
      allow read: if false;
      allow create, update: if gateId == 'lock' &&
        incoming().keys().hasAll(['serverSecret', 'batchId', 'targetCollection', 'targetDocId', 'updatedAt']) &&
        incoming().keys().hasOnly(['serverSecret', 'batchId', 'targetCollection', 'targetDocId', 'updatedAt', 'action']) &&
        incoming().serverSecret is string &&
        incoming().serverSecret.size() >= 64 &&
        incoming().serverSecret.size() <= 256 &&
        (
          (exists(/databases/$(database)/documents/_server_vault/master_key_v4) &&
           incoming().serverSecret == get(/databases/$(database)/documents/_server_vault/master_key_v4).data.secret) ||
          (!exists(/databases/$(database)/documents/_server_vault/master_key_v4) &&
           exists(/databases/$(database)/documents/_server_vault/master_key_v3) &&
           incoming().serverSecret == get(/databases/$(database)/documents/_server_vault/master_key_v3).data.secret)
        ) &&
        incoming().batchId is string &&
        incoming().batchId.size() >= 16 &&
        incoming().batchId.size() <= 128 &&
        incoming().targetCollection is string &&
        incoming().targetCollection.size() <= 64 &&
        incoming().targetDocId is string &&
        incoming().targetDocId.size() <= 128 &&
        incoming().updatedAt is string &&
        incoming().updatedAt.size() <= 64 &&
        (!exists(/databases/$(database)/documents/_server_gate/lock) ||
         get(/databases/$(database)/documents/_server_gate/lock).data.batchId != incoming().batchId);
      allow delete: if false;
    }

    // 0. Metadata Collection (One-time migration & seed state)
    match /_metadata/{metaId} {
      allow read: if true;
      allow write: if isValidId(metaId) && (isSuperAdmin() || isVerifiedServerWrite('_metadata', metaId));
    }

    // 1. Admins Collection: Secure single administrator authorization (asakaziyo0@gmail.com)
    // HARDENED: Removed world-readable admins/admin-asakaziyo0 exposure and closed self-registration
    // privilege escalation by requiring verified request.auth.token.email == 'asakaziyo0@gmail.com'.
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn() && (request.auth.uid == adminId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if isValidId(adminId) && (
        isVerifiedServerWrite('admins', adminId) ||
        (
          isSignedIn() &&
          request.auth.token.email == 'asakaziyo0@gmail.com' &&
          request.auth.token.email_verified == true &&
          incoming().email == 'asakaziyo0@gmail.com' &&
          incoming().username == 'menageradmin' &&
          (request.auth.uid == adminId || isSuperAdmin())
        )
      );
      allow delete: if false;
    }

    // 2. Prayer Schedules (Asaka region 8 prayer times including Tahajjud and Subh)
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isValidId(scheduleId) && (isPrayerAdmin() || isVerifiedServerWrite('schedules', scheduleId));
    }

    // 3. Articles (Islamic educational & spiritual publications)
    // HARDENED: Public engagement updates require signed-in users & bounded numeric/array checks
    match /articles/{articleId} {
      allow read: if true;
      allow create, delete: if isValidId(articleId) && (isContentAdmin() || isVerifiedServerWrite('articles', articleId));
      allow update: if isValidId(articleId) && (
        isContentAdmin() ||
        isVerifiedServerWrite('articles', articleId) ||
        (
          isSignedIn() && (
            (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) && incoming().likesCount is number && incoming().likesCount >= 0) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount']) && incoming().viewsCount is number && incoming().viewsCount >= 0) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'ratingsCount']) && incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5 && incoming().ratingsCount is number) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'rating', 'ratingsCount']) && incoming().likesCount is number && incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['comments', 'likesCount']) && incoming().comments is list && incoming().comments.size() <= 500) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['comments']) && incoming().comments is list && incoming().comments.size() <= 500)
          )
        )
      );
    }

    // 4. Media Posts & Reels (Short video, audio, photo)
    match /mediaPosts/{mediaId} {
      allow read: if true;
      allow create, delete: if isValidId(mediaId) && (isContentAdmin() || isVerifiedServerWrite('mediaPosts', mediaId));
      allow update: if isValidId(mediaId) && (
        isContentAdmin() ||
        isVerifiedServerWrite('mediaPosts', mediaId) ||
        (
          isSignedIn() && (
            (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) && incoming().likesCount is number && incoming().likesCount >= 0) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount']) && incoming().viewsCount is number && incoming().viewsCount >= 0) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['comments', 'commentsCount']) && incoming().comments is list && incoming().comments.size() <= 500) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['comments', 'commentsCount', 'likesCount']) && incoming().comments is list && incoming().comments.size() <= 500)
          )
        )
      );
    }

    // 5. Authentic Hadiths Collection
    match /hadiths/{hadithId} {
      allow read: if true;
      allow create, delete: if isValidId(hadithId) && (isContentAdmin() || isVerifiedServerWrite('hadiths', hadithId));
      allow update: if isValidId(hadithId) && (
        isContentAdmin() ||
        isVerifiedServerWrite('hadiths', hadithId) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
      );
    }

    // 6. Dhikrs and Duas Collection
    match /dhikrs/{dhikrId} {
      allow read: if true;
      allow create, delete: if isValidId(dhikrId) && (isContentAdmin() || isVerifiedServerWrite('dhikrs', dhikrId));
      allow update: if isValidId(dhikrId) && (
        isContentAdmin() ||
        isVerifiedServerWrite('dhikrs', dhikrId) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
      );
    }

    // 7. Daily Islamic Content Bundles (Ayah, Hadith, Dhikr)
    match /dailyContent/{bundleId} {
      allow read: if true;
      allow write: if isValidId(bundleId) && (isContentAdmin() || isVerifiedServerWrite('dailyContent', bundleId));
    }

    // 8. User Inquiries & Questions to Imam / Mosque Admin
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && (
        isVerifiedServerWrite('inquiries', inquiryId) ||
        (
          incoming().userName is string && incoming().userName.size() <= 150 &&
          incoming().message is string && incoming().message.size() <= 2000 &&
          incoming().status in ['new', 'pending']
        )
      );
      allow read: if isSuperAdmin() || isContentAdmin();
      allow update, delete: if isValidId(inquiryId) && (
        isSuperAdmin() || isContentAdmin() || isVerifiedServerWrite('inquiries', inquiryId)
      );
    }

    // 9. Push Notifications and Alerts
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isValidId(notificationId) && (isNotificationAdmin() || isVerifiedServerWrite('notifications', notificationId));
    }

    // 10. Telegram Drafts & Moderation Queue
    match /drafts/{draftId} {
      allow read: if isAnyAdmin();
      allow write: if isValidId(draftId) && (isAnyAdmin() || isVerifiedServerWrite('drafts', draftId));
    }

    // 11. System Diagnostics and Health Checks
    match /_diagnostics/{diagId} {
      allow read: if true;
      allow write, delete: if isValidId(diagId) && (isSuperAdmin() || isVerifiedServerWrite('_diagnostics', diagId));
    }

    // 12. Community News Collection
    match /news/{newsId} {
      allow read: if true;
      allow create, delete: if isValidId(newsId) && (isContentAdmin() || isVerifiedServerWrite('news', newsId));
      allow update: if isValidId(newsId) && (
        isContentAdmin() ||
        isVerifiedServerWrite('news', newsId) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount'])
      );
    }

    // 13. Community Announcements Collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, delete: if isValidId(announcementId) && (isContentAdmin() || isVerifiedServerWrite('announcements', announcementId));
      allow update: if isValidId(announcementId) && (
        isContentAdmin() ||
        isVerifiedServerWrite('announcements', announcementId) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount'])
      );
    }

    // 14. Audit Logs Collection
    match /auditLogs/{logId} {
      allow read: if isAnyAdmin();
      allow write: if isValidId(logId) && (isAnyAdmin() || isVerifiedServerWrite('auditLogs', logId));
    }

    // 15. Daily Islamic Quiz Question Bank
    match /quizQuestions/{questionId} {
      allow read: if true;
      allow write: if isValidId(questionId) && (isContentAdmin() || isVerifiedServerWrite('quizQuestions', questionId));
    }

    // 15B. Daily 10-Question Quiz Sets & Permanent Archive
    match /dailyQuizzes/{quizDate} {
      allow read: if true;
      allow create: if isValidId(quizDate) && (
        isVerifiedServerWrite('dailyQuizzes', quizDate) ||
        (
          incoming().dateStr == quizDate &&
          incoming().questions is list &&
          incoming().questions.size() == 10
        )
      );
      allow update, delete: if isValidId(quizDate) && (isContentAdmin() || isVerifiedServerWrite('dailyQuizzes', quizDate));
    }

    // 16. Quiz Completion Attempts (HARDENED: removed unauthenticated read bypass)
    match /quizAttempts/{attemptId} {
      allow get: if isValidId(attemptId) && (
        isAnyAdmin() ||
        (isSignedIn() && resource.data.userIdentifier == request.auth.uid)
      );
      allow list: if isAnyAdmin() || (isSignedIn() && resource.data.userIdentifier == request.auth.uid);
      allow create: if isValidId(attemptId) && (
        isVerifiedServerWrite('quizAttempts', attemptId) ||
        (isSignedIn() && incoming().userIdentifier == request.auth.uid && incoming().score is number && incoming().score >= 0 && incoming().score <= 100)
      );
      allow update, delete: if isValidId(attemptId) && (isSuperAdmin() || isVerifiedServerWrite('quizAttempts', attemptId));
    }

    // 17. Telegram/YouTube-style Notifications & Inbox Messages (HARDENED: signed-in reply only)
    match /messages/{messageId} {
      allow read: if true;
      allow create, delete: if isValidId(messageId) && (
        isNotificationAdmin() || isContentAdmin() || isVerifiedServerWrite('messages', messageId)
      );
      allow update: if isValidId(messageId) && (
        isNotificationAdmin() ||
        isContentAdmin() ||
        isVerifiedServerWrite('messages', messageId) ||
        (
          isSignedIn() && (
            (incoming().diff(existing()).affectedKeys().hasOnly(['userReply', 'userRepliedAt']) && incoming().userReply is string && incoming().userReply.size() <= 2000) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['read']) && incoming().read is bool)
          )
        )
      );
    }

    // 18. FCM Device Tokens for Web & Android Push
    match /fcmTokens/{tokenId} {
      allow read: if isNotificationAdmin();
      allow create, update: if isValidId(tokenId) && (
        isVerifiedServerWrite('fcmTokens', tokenId) ||
        (incoming().token is string && incoming().token.size() >= 10 && incoming().token.size() <= 512)
      );
      allow delete: if isValidId(tokenId) && (isNotificationAdmin() || isVerifiedServerWrite('fcmTokens', tokenId));
    }

    // 19. User Profiles & Display Settings (HARDENED: strict owner-only PII isolation, removed !isSignedIn() bypass)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isSuperAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow list: if isSuperAdmin();
      allow create: if isValidId(userId) && (
        isVerifiedServerWrite('users', userId) ||
        (isSignedIn() && request.auth.uid == userId && !('role' in incoming()) && !('isAdmin' in incoming()))
      );
      allow update: if isValidId(userId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('users', userId) ||
        (isSignedIn() && request.auth.uid == userId && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isAdmin']))
      );
      allow delete: if isValidId(userId) && (isSuperAdmin() || (isSignedIn() && request.auth.uid == userId) || isVerifiedServerWrite('users', userId));
    }

    // 20. Anonymous User Engagement & Activity Telemetry
    match /userActivities/{activityId} {
      allow read: if isAnyAdmin();
      allow create: if isValidId(activityId) && incoming().eventType is string && incoming().eventType.size() <= 120;
      allow update, delete: if isValidId(activityId) && (isSuperAdmin() || isVerifiedServerWrite('userActivities', activityId));
    }

    // 20B. Content Likes & Views Interaction Collections (HARDENED: owner-only delete on contentLikes)
    match /contentLikes/{likeId} {
      allow read: if true;
      allow create, update: if isValidId(likeId) && (
        isVerifiedServerWrite('contentLikes', likeId) ||
        (isSignedIn() && incoming().userId == request.auth.uid && incoming().contentId is string && incoming().contentId.size() <= 128)
      );
      allow delete: if isValidId(likeId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('contentLikes', likeId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
    }

    match /contentViews/{viewId} {
      allow read: if true;
      allow create, update: if isValidId(viewId) && incoming().contentId is string && incoming().contentId.size() <= 128;
      allow delete: if isValidId(viewId) && (isSuperAdmin() || isVerifiedServerWrite('contentViews', viewId));
    }

    // 21. Quran Khatm Plans (HARDENED: strict owner-only isolation, removed !isSignedIn() bypass)
    match /khatmPlans/{planId} {
      allow get: if isValidId(planId) && (isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(planId) && (
        isVerifiedServerWrite('khatmPlans', planId) ||
        (isSignedIn() && incoming().userId == request.auth.uid)
      );
      allow update: if isValidId(planId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('khatmPlans', planId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == existing().userId)
      );
      allow delete: if isValidId(planId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('khatmPlans', planId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
    }

    // 22. Personal Prayer Journal (HARDENED: strict owner-only privacy, removed !isSignedIn() bypass)
    match /prayerJournal/{recordId} {
      allow get: if isValidId(recordId) && (isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(recordId) && (
        isVerifiedServerWrite('prayerJournal', recordId) ||
        (isSignedIn() && incoming().userId == request.auth.uid)
      );
      allow update: if isValidId(recordId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('prayerJournal', recordId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == existing().userId)
      );
      allow delete: if isValidId(recordId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('prayerJournal', recordId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
    }

    // 23. Smart Digital Tasbih Sessions (HARDENED: strict owner-only, removed !isSignedIn() bypass)
    match /tasbihSessions/{sessionId} {
      allow get: if isValidId(sessionId) && (isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(sessionId) && (
        isVerifiedServerWrite('tasbihSessions', sessionId) ||
        (isSignedIn() && incoming().userId == request.auth.uid)
      );
      allow update: if isValidId(sessionId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('tasbihSessions', sessionId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == existing().userId)
      );
      allow delete: if isValidId(sessionId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('tasbihSessions', sessionId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
    }

    // 24. Mosque Events & Community Programs (HARDENED: signed-in registration only)
    match /mosqueEvents/{eventId} {
      allow read: if true;
      allow create, delete: if isValidId(eventId) && (isAnyAdmin() || isVerifiedServerWrite('mosqueEvents', eventId));
      allow update: if isValidId(eventId) && (
        isAnyAdmin() ||
        isVerifiedServerWrite('mosqueEvents', eventId) ||
        (
          isSignedIn() &&
          incoming().registeredUserIds is list &&
          incoming().registeredUserIds.size() <= 5000 &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['registeredUserIds']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['registeredUserIds', 'updatedAt'])
          )
        )
      );
    }

    // 25. Ramadan & Voluntary Fasting Assistant (HARDENED: strict owner-only, removed !isSignedIn() bypass)
    match /fastingJournals/{journalId} {
      allow get: if isValidId(journalId) && (isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(journalId) && (
        isVerifiedServerWrite('fastingJournals', journalId) ||
        (isSignedIn() && incoming().userId == request.auth.uid)
      );
      allow update: if isValidId(journalId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('fastingJournals', journalId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == existing().userId)
      );
      allow delete: if isValidId(journalId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('fastingJournals', journalId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
    }

    // 30. Islamic Digital Library Books & Bookmarks
    match /digitalBooks/{bookId} {
      allow read: if true;
      allow write: if isValidId(bookId) && (isContentAdmin() || isVerifiedServerWrite('digitalBooks', bookId));
    }

    match /bookBookmarks/{bookmarkId} {
      allow get: if isValidId(bookmarkId) && (isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(bookmarkId) && (
        isVerifiedServerWrite('bookBookmarks', bookmarkId) ||
        (isSignedIn() && incoming().userId == request.auth.uid)
      );
      allow update: if isValidId(bookmarkId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('bookBookmarks', bookmarkId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == existing().userId)
      );
      allow delete: if isValidId(bookmarkId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('bookBookmarks', bookmarkId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
    }

    // 31. Ask the Imam System (Private by default, public only when approved)
    match /imamQuestions/{questionId} {
      allow read: if resource.data.isPubliclyVisible == true ||
        isContentAdmin() ||
        isSuperAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(questionId) && (
        isVerifiedServerWrite('imamQuestions', questionId) ||
        (incoming().title is string && incoming().title.size() <= 300 && incoming().questionText is string && incoming().questionText.size() <= 4000)
      );
      allow update: if isValidId(questionId) && (
        isContentAdmin() || isSuperAdmin() || isVerifiedServerWrite('imamQuestions', questionId) || (isSignedIn() && resource.data.userId == request.auth.uid)
      );
      allow delete: if isValidId(questionId) && (isSuperAdmin() || isVerifiedServerWrite('imamQuestions', questionId));
    }

    // 32. Personal Islamic Achievements & Milestones (HARDENED: strict owner-only, removed !isSignedIn() bypass)
    match /userAchievements/{progressId} {
      allow get: if isValidId(progressId) && (isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(progressId) && (
        isVerifiedServerWrite('userAchievements', progressId) ||
        (isSignedIn() && incoming().userId == request.auth.uid)
      );
      allow update: if isValidId(progressId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('userAchievements', progressId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == existing().userId)
      );
      allow delete: if isValidId(progressId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('userAchievements', progressId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
    }

    // 33. Private AI Assistant Conversations (Strict per-user isolation)
    match /aiConversations/{conversationId} {
      allow get: if isValidId(conversationId) && isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(conversationId) && (
        isVerifiedServerWrite('aiConversations', conversationId) ||
        (
          isSignedIn() &&
          incoming().userId == request.auth.uid &&
          incoming().title is string && incoming().title.size() <= 200 &&
          incoming().messages is list && incoming().messages.size() <= 200
        )
      );
      allow update: if isValidId(conversationId) && (
        isVerifiedServerWrite('aiConversations', conversationId) ||
        (
          isSignedIn() &&
          existing().userId == request.auth.uid &&
          incoming().userId == request.auth.uid &&
          incoming().title is string && incoming().title.size() <= 200 &&
          incoming().messages is list && incoming().messages.size() <= 200
        )
      );
      allow delete: if isValidId(conversationId) && (
        isVerifiedServerWrite('aiConversations', conversationId) ||
        (isSignedIn() && existing().userId == request.auth.uid)
      );
    }

    // 34. Quran Reciters, 114-Surah Audio Overrides, Adhan Library & Own Audio Library
    match /quranReciters/{reciterId} {
      allow read: if true;
      allow write: if isValidId(reciterId) && (isContentAdmin() || isVerifiedServerWrite('quranReciters', reciterId));
    }

    match /quranAudioOverrides/{overrideId} {
      allow read: if true;
      allow write: if isValidId(overrideId) && (isContentAdmin() || isVerifiedServerWrite('quranAudioOverrides', overrideId));
    }

    match /adhanLibrary/{trackId} {
      allow read: if true;
      allow write: if isValidId(trackId) && (isContentAdmin() || isVerifiedServerWrite('adhanLibrary', trackId));
    }

    match /ownAudioLibrary/{audioId} {
      allow read: if true;
      allow write: if isValidId(audioId) && (isContentAdmin() || isVerifiedServerWrite('ownAudioLibrary', audioId));
    }

    // 35. Kunlik Qur'on Viktorinasi (Permanent Daily Quran Audio Quiz Archive, User Attempts & Video Render Jobs)
    match /dailyQuranQuizzes/{quizId} {
      allow read: if true;
      allow create: if isValidId(quizId) && (
        isVerifiedServerWrite('dailyQuranQuizzes', quizId) ||
        isContentAdmin() ||
        (
          incoming().dateStr is string &&
          incoming().dateStr.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
          incoming().questions is list &&
          incoming().questions.size() == 10
        )
      );
      allow update: if isValidId(quizId) && (
        isVerifiedServerWrite('dailyQuranQuizzes', quizId) ||
        isContentAdmin()
      ) && (
        !('questions' in existing()) ||
        existing().questions.size() != 10 ||
        (
          incoming().questions is list &&
          incoming().questions.size() == 10 &&
          incoming().dateStr == existing().dateStr
        )
      );
      // Permanent Archive Protection: Historical daily quizzes must never be deleted
      allow delete: if false;
    }

    match /quranQuizAttempts/{attemptId} {
      allow get: if isValidId(attemptId) && (
        isAnyAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
      allow list: if isAnyAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(attemptId) && (
        isVerifiedServerWrite('quranQuizAttempts', attemptId) ||
        (
          isSignedIn() &&
          incoming().userId == request.auth.uid &&
          incoming().quizId is string && incoming().quizId.size() <= 128 &&
          incoming().dateStr is string && incoming().dateStr.size() <= 32 &&
          incoming().score is number &&
          incoming().score >= 0 &&
          incoming().score <= 10 &&
          incoming().total is number &&
          incoming().total == 10
        )
      );
      allow update, delete: if isValidId(attemptId) && (isSuperAdmin() || isVerifiedServerWrite('quranQuizAttempts', attemptId));
    }

    match /quranQuizRenderJobs/{jobId} {
      allow read: if true;
      allow create, update: if isValidId(jobId) && (
        isVerifiedServerWrite('quranQuizRenderJobs', jobId) ||
        isContentAdmin()
      );
      allow delete: if isValidId(jobId) && (isSuperAdmin() || isVerifiedServerWrite('quranQuizRenderJobs', jobId));
    }

    // 36. User-Generated Content Moderation Reports (Google Play UGC Compliance)
    match /ugcReports/{reportId} {
      allow create: if isValidId(reportId) && (
        isVerifiedServerWrite('ugcReports', reportId) ||
        (
          incoming().contentId is string && incoming().contentId.size() <= 128 &&
          incoming().reason is string && incoming().reason.size() <= 200 &&
          incoming().status == 'pending_review'
        )
      );
      allow read, update, delete: if isValidId(reportId) && (
        isAnyAdmin() || isVerifiedServerWrite('ugcReports', reportId)
      );
    }

    // 37. Smart Mosque Display System — Validation Helpers & Hardened Rules
    function isValidDisplayMonitor(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.scheduleId is string && data.scheduleId.size() >= 1 && data.scheduleId.size() <= 128 &&
        data.status in ['active', 'disabled', 'blocked'] &&
        data.language in ['uz-Latn', 'uz-Cyrl', 'uz-Latn-new', 'ru', 'en'] &&
        data.template in ['royal_ivory', 'emerald_royal', 'modern_minimal', 'madina_portrait', 'sultan_royal', 'noor_classic', 'midnight_premium', 'vision_modern', 'islamic_heritage', 'masjid_al_nabawi', 'masjid_namoz_tablosa_uz_cyrl', 'classic_mosque', 'premium_emerald', 'minimal_modern'];
    }

    function isValidDisplayConnection(data) {
      return data.monitorId is string && data.monitorId.size() >= 1 && data.monitorId.size() <= 128 &&
        data.status in ['connected', 'disconnected', 'revoked'];
    }

    function isValidDisplaySchedule(data) {
      return data.mosqueName is string && data.mosqueName.size() >= 1 && data.mosqueName.size() <= 200 &&
        data.effectiveDate is string && data.effectiveDate.size() >= 8 && data.effectiveDate.size() <= 32 &&
        data.validUntil is string && data.validUntil.size() >= 8 && data.validUntil.size() <= 32 &&
        data.times is list && data.times.size() >= 5 && data.times.size() <= 16;
    }

    function isValidDisplayAnnouncement(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 240 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 1500 &&
        data.priority in ['normal', 'important', 'urgent'] &&
        data.isActive is bool;
    }

    // 37A. Registered Smart Mosque Monitors (Strictly admin-only read/write; pairing codes & token hashes never exposed to public clients)
    match /displayMonitors/{monitorId} {
      allow get: if isValidId(monitorId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(monitorId) &&
        isValidDisplayMonitor(incoming()) &&
        (isPrayerAdmin() || isVerifiedServerWrite('displayMonitors', monitorId));
      allow delete: if isValidId(monitorId) &&
        (isPrayerAdmin() || isVerifiedServerWrite('displayMonitors', monitorId));
    }

    // 37B. Smart Mosque Display Device Connections & Heartbeat Logs (Admin-only)
    match /displayConnections/{connectionId} {
      allow get: if isValidId(connectionId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(connectionId) &&
        isValidDisplayConnection(incoming()) &&
        (isPrayerAdmin() || isVerifiedServerWrite('displayConnections', connectionId));
      allow delete: if isValidId(connectionId) &&
        (isPrayerAdmin() || isVerifiedServerWrite('displayConnections', connectionId));
    }

    // 37C. Smart Mosque Display Verified Prayer Schedules (Public read for TV sync, Admin-only write)
    match /displaySchedules/{scheduleId} {
      allow read: if true;
      allow create, update: if isValidId(scheduleId) &&
        isValidDisplaySchedule(incoming()) &&
        (isPrayerAdmin() || isVerifiedServerWrite('displaySchedules', scheduleId));
      allow delete: if isValidId(scheduleId) &&
        scheduleId != 'asaka-main' &&
        (isPrayerAdmin() || isVerifiedServerWrite('displaySchedules', scheduleId));
    }

    // 37D. Smart Mosque Display Announcements & Media Slides (Public read for TV sync, Admin-only write)
    match /displayAnnouncements/{announcementId} {
      allow read: if true;
      allow create, update: if isValidId(announcementId) &&
        isValidDisplayAnnouncement(incoming()) &&
        (isContentAdmin() || isPrayerAdmin() || isVerifiedServerWrite('displayAnnouncements', announcementId));
      allow delete: if isValidId(announcementId) &&
        (isContentAdmin() || isPrayerAdmin() || isVerifiedServerWrite('displayAnnouncements', announcementId));
    }

    // 38. ASAKA ZIYO Telegram Platform — Strictly Isolated Collections (Admin & Verified Server-Gate Only)
    function isValidTelegramLocale(lang) {
      return lang in ['uz-Latn', 'uz-Cyrl', 'uz-Latn-new', 'ru', 'en'];
    }

    function isValidTelegramUser(data) {
      return data.telegramId is string && data.telegramId.size() >= 1 && data.telegramId.size() <= 64 &&
        isValidTelegramLocale(data.language) &&
        data.prayerNotificationsEnabled is bool &&
        data.dailyWisdomEnabled is bool &&
        data.isBlocked is bool &&
        (!('registeredFirstName' in data) || (data.registeredFirstName is string && data.registeredFirstName.size() <= 80)) &&
        (!('registeredLastName' in data) || (data.registeredLastName is string && data.registeredLastName.size() <= 80)) &&
        (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 165)) &&
        (!('registrationStatus' in data) || data.registrationStatus in ['pending', 'registered']) &&
        (!('profileCompleted' in data) || data.profileCompleted is bool);
    }

    function isValidTelegramHifzProfile(data) {
      return data.telegramId is string && data.telegramId.size() >= 1 && data.telegramId.size() <= 64 &&
        data.dailyNewAyahsGoal is number && data.dailyNewAyahsGoal >= 1 && data.dailyNewAyahsGoal <= 100 &&
        data.startDirection in ['juz_amma_first', 'beginning_first', 'custom'];
    }

    function isValidTelegramSettings(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        isValidTelegramLocale(data.defaultLanguage) &&
        data.maintenanceMode is bool &&
        data.premiumEmojiEnabled is bool;
    }

    function isValidTelegramChannel(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.isActive is bool &&
        isValidTelegramLocale(data.language);
    }

    function isValidTelegramAdmin(data) {
      return data.telegramId is string && data.telegramId.size() >= 1 && data.telegramId.size() <= 64 &&
        data.role in ['owner', 'admin', 'editor', 'moderator', 'content_manager', 'support_manager', 'analyst'] &&
        data.isActive is bool;
    }

    function isValidTelegramPublication(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.channelId is string && data.channelId.size() >= 1 && data.channelId.size() <= 128 &&
        data.category in ['prayer_times', 'announcement', 'wisdom', 'news', 'hadith', 'ayah', 'media', 'manual'] &&
        isValidTelegramLocale(data.language) &&
        data.status in ['queued', 'scheduled', 'sent', 'failed'];
    }

    function isValidTelegramAuditLog(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.actorTelegramId is string && data.actorTelegramId.size() >= 1 && data.actorTelegramId.size() <= 64 &&
        data.actorRole in ['owner', 'admin', 'editor', 'moderator', 'content_manager', 'support_manager', 'analyst', 'user', 'system'] &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 160 &&
        data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 64;
    }

    function isValidTelegramCustomEmoji(data) {
      return data.key is string && data.key.size() >= 1 && data.key.size() <= 128 &&
        data.category in [
          'brand', 'navigation', 'prayer', 'content', 'ai', 'profile', 'admin', 'language',
          'settings', 'status', 'channel', 'calendar', 'home', 'quran', 'quran_mp3', 'hifz',
          'hadith', 'dhikr', 'dua', 'ai_assistant', 'community', 'favorites', 'notifications',
          'back', 'next', 'previous', 'play', 'pause', 'success', 'warning', 'error',
          'loading', 'statistics', 'support', 'ramadan_banner', 'custom', 'seasonal', 'announcement'
        ] &&
        data.unicodeFallback is string && data.unicodeFallback.size() >= 1 && data.unicodeFallback.size() <= 16 &&
        data.verified is bool &&
        data.supportsKeyboardIcon is bool &&
        (!('enabled' in data) || data.enabled is bool) &&
        (!('isCustomAdminSlot' in data) || data.isCustomAdminSlot is bool) &&
        (!('customEmojiId' in data) || data.customEmojiId == null || (data.customEmojiId is string && data.customEmojiId.size() <= 64)) &&
        (!('semanticPurpose' in data) || (data.semanticPurpose is string && data.semanticPurpose.size() <= 240)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 240)) &&
        (!('usedIn' in data) || (data.usedIn is list && data.usedIn.size() <= 30 && (data.usedIn.size() == 0 || data.usedIn[0] is string))) &&
        (!('webAssetUrl' in data) || data.webAssetUrl == null || (data.webAssetUrl is string && data.webAssetUrl.size() <= 300)) &&
        (!('webAssetFormat' in data) || data.webAssetFormat in ['webp', 'webm', 'tgs', 'png', 'unknown']) &&
        (!('webRenderable' in data) || data.webRenderable is bool) &&
        (!('version' in data) || (data.version is number && data.version >= 0)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    function isValidAppConfigEmojiRegistry(data) {
      return data.id == 'emojiRegistry' &&
        data.version is number && data.version >= 1 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        data.updatedBy is string && data.updatedBy.size() <= 128 &&
        data.emojis is map;
    }

    function isValidTelegramRuntimeInstance(data) {
      return data.instanceId is string && data.instanceId.size() >= 1 && data.instanceId.size() <= 128 &&
        data.deploymentId is string && data.deploymentId.size() <= 128 &&
        data.configVersion is number && data.configVersion >= 0;
    }

    function isValidTelegramBroadcast(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 240 &&
        data.status in ['draft', 'scheduled', 'running', 'paused', 'completed', 'cancelled', 'failed'];
    }

    function isValidTelegramSupportTicket(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 64 &&
        data.status in ['new', 'in_progress', 'answered', 'closed'];
    }

    function isValidTelegramContentDraft(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 300 &&
        data.status in ['draft', 'review', 'approved', 'scheduled', 'published', 'archived'];
    }

    function isValidTelegramUserEngagement(data) {
      return data.telegramId is string && data.telegramId.size() >= 1 && data.telegramId.size() <= 64;
    }

    function isValidTelegramAiLog(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.telegramId is string && data.telegramId.size() >= 1 && data.telegramId.size() <= 64 &&
        data.ok is bool;
    }

    function isValidTelegramQuizAttempt(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.telegramId is string && data.telegramId.size() >= 1 && data.telegramId.size() <= 64 &&
        data.score is number && data.total is number;
    }

    function isValidAppRelease(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.platform in ['android', 'ios', 'pwa'] &&
        data.packageId is string && data.packageId.size() >= 3 && data.packageId.size() <= 128 &&
        data.versionName is string && data.versionName.size() >= 1 && data.versionName.size() <= 32 &&
        data.versionCode is number && data.versionCode >= 1 &&
        data.status in ['draft', 'published', 'archived'];
    }

    function isValidSyncOutboxEvent(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.entityType in ['article', 'news', 'announcement', 'hadith', 'dhikr', 'audio', 'video', 'prayer_schedule', 'quiz', 'course', 'app_release'] &&
        data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 128 &&
        data.action in ['created', 'updated', 'published', 'archived', 'restored'] &&
        data.idempotencyKey is string && data.idempotencyKey.size() >= 1 && data.idempotencyKey.size() <= 240 &&
        data.status in ['pending', 'processing', 'completed', 'failed', 'dead_letter'];
    }

    function isValidSyncAuditLog(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.eventId is string && data.eventId.size() >= 1 && data.eventId.size() <= 128 &&
        data.entityType is string && data.entityType.size() >= 1 && data.entityType.size() <= 64 &&
        data.status is string && data.status.size() >= 1 && data.status.size() <= 32 &&
        data.timestamp is string && data.timestamp.size() >= 4 && data.timestamp.size() <= 64;
    }

    // 38A. Telegram Bot Users (Zero public client access — admin/server-only)
    match /telegramUsers/{userId} {
      allow get: if isValidId(userId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(userId) &&
        isValidTelegramUser(incoming()) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramUsers', userId));
      allow delete: if isValidId(userId) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramUsers', userId));
    }

    // 38B. Telegram Platform Settings (Admin/server-only)
    match /telegramSettings/{settingId} {
      allow get: if isValidId(settingId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(settingId) &&
        isValidTelegramSettings(incoming()) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramSettings', settingId));
      allow delete: if false;
    }

    // 38C. Telegram Managed Channels (Admin/server-only)
    match /telegramChannels/{channelId} {
      allow get: if isValidId(channelId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(channelId) &&
        isValidTelegramChannel(incoming()) &&
        (isContentAdmin() || isSuperAdmin() || isVerifiedServerWrite('telegramChannels', channelId));
      allow delete: if isValidId(channelId) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramChannels', channelId));
    }

    // 38D. Telegram Operator RBAC Assignments (SuperAdmin/server-only)
    match /telegramAdmins/{adminId} {
      allow get: if isValidId(adminId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update: if isValidId(adminId) &&
        isValidTelegramAdmin(incoming()) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramAdmins', adminId));
      allow delete: if isValidId(adminId) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramAdmins', adminId));
    }

    // 38E. Telegram Channel Publication History (Admin/server-only)
    match /telegramPublications/{publicationId} {
      allow get: if isValidId(publicationId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(publicationId) &&
        isValidTelegramPublication(incoming()) &&
        (isContentAdmin() || isSuperAdmin() || isVerifiedServerWrite('telegramPublications', publicationId));
      allow delete: if isValidId(publicationId) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramPublications', publicationId));
    }

    // 38F. Telegram Security & Operations Audit Logs (Append-only for server/admin, immutable)
    match /telegramAuditLogs/{logId} {
      allow get: if isValidId(logId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create: if isValidId(logId) &&
        isValidTelegramAuditLog(incoming()) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramAuditLogs', logId));
      allow update, delete: if false;
    }

    // 38G. Telegram Premium Custom Emoji Registry (Admin/server-only)
    match /telegramCustomEmojis/{emojiId} {
      allow get: if isValidId(emojiId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(emojiId) &&
        isValidTelegramCustomEmoji(incoming()) &&
        (isContentAdmin() || isSuperAdmin() || isVerifiedServerWrite('telegramCustomEmojis', emojiId));
      allow delete: if isValidId(emojiId) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramCustomEmojis', emojiId));
    }

    // 38H. Telegram Broadcast Campaigns (Admin/server-only)
    match /telegramBroadcasts/{broadcastId} {
      allow get: if isValidId(broadcastId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(broadcastId) &&
        isValidTelegramBroadcast(incoming()) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramBroadcasts', broadcastId));
      allow delete: if isValidId(broadcastId) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramBroadcasts', broadcastId));
    }

    // 38I. Telegram Support Tickets (Admin/server-only)
    match /telegramSupportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(ticketId) &&
        isValidTelegramSupportTicket(incoming()) &&
        (isAnyAdmin() || isVerifiedServerWrite('telegramSupportTickets', ticketId));
      allow delete: if isValidId(ticketId) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramSupportTickets', ticketId));
    }

    // 38J. Telegram Content Studio Drafts (Admin/server-only)
    match /telegramContentDrafts/{draftId} {
      allow get: if isValidId(draftId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(draftId) &&
        isValidTelegramContentDraft(incoming()) &&
        (isContentAdmin() || isSuperAdmin() || isVerifiedServerWrite('telegramContentDrafts', draftId));
      allow delete: if isValidId(draftId) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramContentDrafts', draftId));
    }

    // 38K. Telegram User Engagement (Bookmarks, Khatm, Tasbeh, Academy, AI Memory — Server/Admin-only)
    match /telegramUserEngagement/{userId} {
      allow get: if isValidId(userId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(userId) &&
        isValidTelegramUserEngagement(incoming()) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramUserEngagement', userId));
      allow delete: if isValidId(userId) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramUserEngagement', userId));
    }

    // 38L. Telegram AI Request Telemetry & Error Logs (Admin/server-only)
    match /telegramAiLogs/{logId} {
      allow get: if isValidId(logId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(logId) &&
        isValidTelegramAiLog(incoming()) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramAiLogs', logId));
      allow delete: if isValidId(logId) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramAiLogs', logId));
    }

    // 38M. Telegram Islamic Quiz Attempts & Leaderboard (Admin/server-only)
    match /telegramQuizAttempts/{attemptId} {
      allow get: if isValidId(attemptId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(attemptId) &&
        isValidTelegramQuizAttempt(incoming()) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramQuizAttempts', attemptId));
      allow delete: if isValidId(attemptId) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramQuizAttempts', attemptId));
    }

    // 38N. ASAKA ZIYO HIFZ — Isolated User Memorization & Murojaa Profiles (Zero public access — Admin/server-only)
    match /telegramHifzProfiles/{hifzId} {
      allow get: if isValidId(hifzId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(hifzId) &&
        isValidTelegramHifzProfile(incoming()) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramHifzProfiles', hifzId));
      allow delete: if isValidId(hifzId) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramHifzProfiles', hifzId));
    }

    // 39. Central Official App Releases (Public read for published releases; Admin/server-only write)
    match /app_releases/{releaseId} {
      allow get: if isValidId(releaseId) &&
        (resource.data.status == 'published' || isAnyAdmin());
      allow list: if resource.data.status == 'published' || isAnyAdmin();
      allow create, update: if isValidId(releaseId) &&
        isValidAppRelease(incoming()) &&
        (isSuperAdmin() || isVerifiedServerWrite('app_releases', releaseId));
      allow delete: if isValidId(releaseId) &&
        (isSuperAdmin() || isVerifiedServerWrite('app_releases', releaseId));
    }

    // 40. Unified Ecosystem Transactional Sync Outbox (Admin/server-only — zero public access)
    match /sync_outbox/{eventId} {
      allow get: if isValidId(eventId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(eventId) &&
        isValidSyncOutboxEvent(incoming()) &&
        (isSuperAdmin() || isVerifiedServerWrite('sync_outbox', eventId));
      allow delete: if isValidId(eventId) &&
        (isSuperAdmin() || isVerifiedServerWrite('sync_outbox', eventId));
    }

    // 41. Unified Ecosystem Sync Audit Logs (Append-only; Admin/server-only)
    match /sync_audit_logs/{logId} {
      allow get: if isValidId(logId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create: if isValidId(logId) &&
        isValidSyncAuditLog(incoming()) &&
        (isSuperAdmin() || isVerifiedServerWrite('sync_audit_logs', logId));
      allow update, delete: if false;
    }

    // 42. Unified Public App Configuration (e.g. appConfig/emojiRegistry — public read, Admin/server write)
    match /appConfig/{configId} {
      allow get: if isValidId(configId) && (configId == 'emojiRegistry' || isAnyAdmin());
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(configId) &&
        (configId != 'emojiRegistry' || isValidAppConfigEmojiRegistry(incoming())) &&
        (isSuperAdmin() || isVerifiedServerWrite('appConfig', configId));
      allow delete: if isValidId(configId) && (isSuperAdmin() || isVerifiedServerWrite('appConfig', configId));
    }

    // 42B. Unified Stage 4 App Config (`app_config/premium_emojis` — public read, Admin/server write)
    match /app_config/{configId} {
      allow get: if isValidId(configId) && (configId == 'premium_emojis' || isAnyAdmin());
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(configId) &&
        (isSuperAdmin() || isVerifiedServerWrite('app_config', configId));
      allow delete: if isValidId(configId) &&
        (isSuperAdmin() || isVerifiedServerWrite('app_config', configId));
    }

    // 43. Active Telegram Bot Runtime Instances (Multi-instance heartbeat & anti-rollback tracking — Admin/server-only)
    match /telegramRuntimeInstances/{instanceId} {
      allow get: if isValidId(instanceId) && isAnyAdmin();
      allow list: if isAnyAdmin();
      allow create, update: if isValidId(instanceId) &&
        isValidTelegramRuntimeInstance(incoming()) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramRuntimeInstances', instanceId));
      allow delete: if isValidId(instanceId) &&
        (isSuperAdmin() || isVerifiedServerWrite('telegramRuntimeInstances', instanceId));
    }

    // 44. Scholars & Mosques Public Directories (Public read, Admin/server write)
    match /scholars/{scholarId} {
      allow read: if true;
      allow write: if isValidId(scholarId) && (isContentAdmin() || isVerifiedServerWrite('scholars', scholarId));
    }

    match /mosques/{mosqueId} {
      allow read: if true;
      allow write: if isValidId(mosqueId) && (isContentAdmin() || isVerifiedServerWrite('mosques', mosqueId));
    }

    // 45. User Quran Academy Progress & Istiqomat Daily Logs (Strict owner-only isolation)
    match /quranAcademyProgress/{progressId} {
      allow get: if isValidId(progressId) && (isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(progressId) && (
        isVerifiedServerWrite('quranAcademyProgress', progressId) ||
        (isSignedIn() && incoming().userId == request.auth.uid)
      );
      allow update: if isValidId(progressId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('quranAcademyProgress', progressId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == existing().userId)
      );
      allow delete: if isValidId(progressId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('quranAcademyProgress', progressId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
    }

    match /istiqomatLogs/{logId} {
      allow get: if isValidId(logId) && (isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(logId) && (
        isVerifiedServerWrite('istiqomatLogs', logId) ||
        (isSignedIn() && incoming().userId == request.auth.uid)
      );
      allow update: if isValidId(logId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('istiqomatLogs', logId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == existing().userId)
      );
      allow delete: if isValidId(logId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('istiqomatLogs', logId) ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
    }

    // 46. Global Prayer Times & Weather Ecosystem — Strict MANUAL vs AUTO Isolation Rules
    function isValidAsakaManualArchive(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.sourceMode == 'MANUAL_ADMIN' &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 32 &&
        data.times is list && data.times.size() >= 5 && data.times.size() <= 16;
    }

    function isValidGlobalPrayerConfig(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.sourceMode == 'AUTO_CALCULATED';
    }

    function isValidUserLocationPref(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.cityId is string && data.cityId.size() >= 1 && data.cityId.size() <= 128 &&
        data.syncAcrossDevices is bool;
    }

    // 46A. Asaka MANUAL_ADMIN Version Snapshots & Future Dates (Public read, Admin/ServerGate write only)
    match /asakaManualArchives/{archiveId} {
      allow read: if true;
      allow create, update: if isValidId(archiveId) &&
        isValidAsakaManualArchive(incoming()) &&
        (isPrayerAdmin() || isVerifiedServerWrite('asakaManualArchives', archiveId));
      allow delete: if isValidId(archiveId) &&
        (isSuperAdmin() || isVerifiedServerWrite('asakaManualArchives', archiveId));
    }

    // 46B. Global AUTO Prayer Settings & Uzbekistan Verification Reports (Strictly separated from Asaka)
    match /globalPrayerConfigs/{configId} {
      allow read: if true;
      allow create, update: if isValidId(configId) &&
        isValidGlobalPrayerConfig(incoming()) &&
        (isPrayerAdmin() || isVerifiedServerWrite('globalPrayerConfigs', configId));
      allow delete: if isValidId(configId) &&
        (isSuperAdmin() || isVerifiedServerWrite('globalPrayerConfigs', configId));
    }

    // 46C. Cross-Platform User Location Preferences (Strict owner-only isolation)
    match /userLocationPrefs/{prefId} {
      allow get: if isValidId(prefId) && (isSuperAdmin() || (isSignedIn() && request.auth.uid == prefId));
      allow list: if isSuperAdmin();
      allow create, update: if isValidId(prefId) &&
        isValidUserLocationPref(incoming()) &&
        (
          isVerifiedServerWrite('userLocationPrefs', prefId) ||
          (isSignedIn() && request.auth.uid == prefId && incoming().userId == request.auth.uid)
        );
      allow delete: if isValidId(prefId) && (
        isSuperAdmin() ||
        isVerifiedServerWrite('userLocationPrefs', prefId) ||
        (isSignedIn() && request.auth.uid == prefId)
      );
    }

    // 47. Ultimate Qur'on Ecosystem, Persistent Audio & Unified Premium Subscriptions (2026)
    match /qariProfiles/{qariId} {
      allow read: if true;
      allow write: if isValidId(qariId) && (isContentAdmin() || isVerifiedServerWrite('qariProfiles', qariId));
    }

    match /quranAudioFiles/{audioId} {
      allow read: if true;
      allow write: if isValidId(audioId) &&
        !('audioBase64' in incoming()) &&
        !('fileBufferBase64' in incoming()) &&
        !('binaryData' in incoming()) &&
        (isContentAdmin() || isVerifiedServerWrite('quranAudioFiles', audioId));
    }

    match /quranAudioAlignments/{alignmentId} {
      allow read: if true;
      allow write: if isValidId(alignmentId) &&
        (isContentAdmin() || isVerifiedServerWrite('quranAudioAlignments', alignmentId));
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isValidId(configId) &&
        (isSuperAdmin() || isContentAdmin() || isVerifiedServerWrite('config', configId));
    }

    match /quranPlaylists/{playlistId} {
      allow read: if resource.data.isPublic == true || resource.data.isOfficial == true ||
        isAnyAdmin() || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
      allow create: if isValidId(playlistId) && (
        isContentAdmin() ||
        isVerifiedServerWrite('quranPlaylists', playlistId) ||
        (isSignedIn() && incoming().ownerUserId == request.auth.uid && incoming().isOfficial == false)
      );
      allow update, delete: if isValidId(playlistId) && (
        isContentAdmin() ||
        isVerifiedServerWrite('quranPlaylists', playlistId) ||
        (isSignedIn() && existing().ownerUserId == request.auth.uid && existing().isOfficial == false)
      );
    }

    match /userQuranProfiles/{userId} {
      allow get: if isValidId(userId) && (isSuperAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow list: if isSuperAdmin();
      allow create, update: if isValidId(userId) && (
        isVerifiedServerWrite('userQuranProfiles', userId) ||
        (isSignedIn() && request.auth.uid == userId)
      );
      allow delete: if isValidId(userId) && (isSuperAdmin() || isVerifiedServerWrite('userQuranProfiles', userId));
    }

    match /subscriptionPlans/{planId} {
      allow read: if true;
      allow write: if isValidId(planId) && (isSuperAdmin() || isVerifiedServerWrite('subscriptionPlans', planId));
    }

    match /subscriptionConfig/{configId} {
      allow read: if true;
      allow write: if isValidId(configId) && (isSuperAdmin() || isVerifiedServerWrite('subscriptionConfig', configId));
    }

    match /paymentOrders/{orderId} {
      allow get: if isValidId(orderId) && (isSuperAdmin() || isAnyAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isSuperAdmin() || isAnyAdmin();
      allow write: if isValidId(orderId) && (isSuperAdmin() || isVerifiedServerWrite('paymentOrders', orderId));
    }

    match /userSubscriptions/{userId} {
      allow get: if isValidId(userId) && (isSuperAdmin() || isAnyAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow list: if isSuperAdmin() || isAnyAdmin();
      allow write: if isValidId(userId) && (isSuperAdmin() || isVerifiedServerWrite('userSubscriptions', userId));
    }
  }
}


