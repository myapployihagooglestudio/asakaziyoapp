        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">asakaziyo.uz</domain>
        <domain includeSubdomains="true">asakaziyo.ai.studio</domain>
        <domain includeSubdomains="true">appassets.androidplatform.net</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">firebaseio.com</domain>
        <domain includeSubdomains="true">supabase.co</domain>
        <domain includeSubdomains="true">islamic.network</domain>
